# UserAPI Configuration

# Application settings
APP_NAME=UserAPI
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Storage directory where .session files, uploads, and userapi.db SQLite database are stored
STORAGE_DIR=./data

# Optional default Telegram API credentials from https://my.telegram.org
# Users can provide their own credentials per session upon registration.
DEFAULT_API_ID=
DEFAULT_API_HASH=

# Optional global default proxy (can be overridden per user session)
# Examples:
# DEFAULT_PROXY=socks5://127.0.0.1:1080
# DEFAULT_PROXY=socks5://user:pass@127.0.0.1:1080
# DEFAULT_PROXY=http://user:pass@127.0.0.1:8080
# DEFAULT_PROXY=tg://proxy?server=proxy.example.com&port=443&secret=dd0123456789abcdef0123456789abcdef
DEFAULT_PROXY=

# Admin token for server management and user monitoring
ADMIN_TOKEN=admin_secret_token_123

# Default disk storage quota per session in Megabytes (e.g. 500 for 500MB, 1024 for 1GB)
DEFAULT_USER_QUOTA_MB=500

# Maximum upload file size in Megabytes
MAX_UPLOAD_SIZE_MB=50

# Network and Telegram client timeout thresholds
FLOOD_SLEEP_THRESHOLD=60
REQUEST_RETRIES=5
CONNECTION_RETRIES=5
